<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>2.1.5.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="ToolWindows\MyToolWindowContent.xaml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ToolWindows\MyToolWindowContent.xaml">
      <Generator>MSBuild:Compile</Generator>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="17.14.40608" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Build" Version="17.14.40608" PrivateAssets="all" />
  </ItemGroup>

  <!--
    VS 2026 Insiders (18.x) 中，扩展在 ServiceHub 进程外独立 AssemblyLoadContext 加载，
    SDK 默认 SuppressFromVsix 的"宿主共享程序集"在该上下文中访问不到 VS 主进程的 SharedAssemblies，
    导致 ExtensionEntrypoint 类型加载失败、工具窗口无法注册。打开 SDK 提供的开关把它们重新打回 VSIX。
  -->
  <PropertyGroup>
    <IncludeExtensionHostReferencesInVSIXContainer>true</IncludeExtensionHostReferencesInVSIXContainer>
  </PropertyGroup>
</Project>
